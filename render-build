#!/usr/bin/env bash
set -o errexit

# Cài đặt các thư viện Python
pip install -r requirements.txt

# Tải và cài đặt FFmpeg bản Static
echo "Đang tải FFmpeg..."
curl -O https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz
tar -xf ffmpeg-release-amd64-static.tar.xz

# Chép ffmpeg vào thư mục ảo để ứng dụng nhận diện
FFMPEG_DIR=$(find . -maxdepth 1 -type d -name "ffmpeg-*-static")
cp ${FFMPEG_DIR}/ffmpeg .venv/bin/
cp ${FFMPEG_DIR}/ffprobe .venv/bin/

echo "Đã cài đặt FFmpeg thành công!"
